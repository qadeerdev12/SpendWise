@page "/Account/Manage/DeletePersonalData"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using SpendWise.Web.Contracts
@using SpendWise.Web.Data
@inject SpendWise.Web.Services.AccountDeletionService Deletion
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<DeletePersonalData> Logger

<PageTitle>Delete account</PageTitle>
<StatusMessage Message="@message" />
<h3>Delete account</h3>
<div class="alert alert-warning" role="alert">
    <p>This permanently deletes your account, expenses and categories. This cannot be undone.</p>
</div>
<EditForm Model="Input" FormName="delete-user" OnValidSubmit="OnValidSubmitAsync" method="post">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" role="alert" />
    <div class="form-floating mb-3">
        <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="current-password" placeholder="Current password" />
        <label for="Input.Password">Current password</label>
        <ValidationMessage For="() => Input.Password" />
    </div>
    <div class="form-check mb-3">
        <InputCheckbox id="Input.Confirmed" @bind-Value="Input.Confirmed" class="form-check-input" />
        <label for="Input.Confirmed" class="form-check-label">I understand my account and all my expenses and categories will be permanently deleted.</label>
    </div>
    <button class="btn btn-danger" type="submit">Permanently delete my account</button>
</EditForm>

@code {
    private string? message;
    [SupplyParameterFromForm] private InputModel Input { get; set; } = default!;

    // Static SSR binds submitted values before initialization; only initialise an empty form.
    protected override void OnInitialized() => Input ??= new();

    private async Task OnValidSubmitAsync()
    {
        ServiceResult<bool> result;
        try { result = await Deletion.DeleteAsync(Input.Password, Input.Confirmed); }
        catch (Exception ex)
        {
            // Keep diagnostics on the server; never expose database details or the password.
            Logger.LogError(ex, "Account deletion failed.");
            message = "Error: Your account could not be deleted. Please try again.";
            return;
        }
        if (result.Status != ResultStatus.Success)
        {
            message = "Error: " + result.Error;
            return;
        }
        // Cookie changes belong to this normal HTTP account flow, not an interactive circuit.
        await SignInManager.SignOutAsync();
        RedirectManager.RedirectTo("Account/Login");
    }

    private sealed class InputModel
    {
        [Required, DataType(DataType.Password)] public string Password { get; set; } = "";
        public bool Confirmed { get; set; }
    }
}
