@page "/expenses"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Globalization
@using SpendWise.Web.Contracts
@using SpendWise.Web.Components.Expenses
@inherits ExpenseNavigationPage
@inject ExpenseFeedback Feedback
@inject SpendWise.Web.Services.ExpenseService Expenses
@inject SpendWise.Web.Services.CategoryService Categories
@inject SpendWise.Web.Services.CategoryInitializer Initializer
@inject ILogger<ExpenseLedger> Logger

<PageTitle>Expenses · SpendWise</PageTitle>
<div class="ledger">
    <div class="ledger-heading">
        <div><h1>Expenses</h1><p class="text-muted">Your spending, newest first. All amounts are in AUD.</p></div>
        <a class="btn btn-primary" href="expenses/new">Add expense</a>
    </div>
    @if (message is not null)
    {
        <div class="alert alert-success" role="status">@message</div>
    }
    <fieldset disabled="@(loading || !interactive)" class="ledger-filters">
        <legend class="visually-hidden">Filter expenses</legend>
        <div>
            <label for="ledger-month" class="form-label">Month</label>
            <input id="ledger-month" type="month" class="form-control" value="@month" min="2000-01" max="@CurrentMonth" @onchange="MonthChangedAsync" />
        </div>
        <div>
            <label for="ledger-category" class="form-label">Category</label>
            <select id="ledger-category" class="form-select" value="@categoryId" @onchange="CategoryChangedAsync">
                <option value="0">All categories</option>
                @foreach (var category in categories)
                {
                    <option value="@category.Id">@category.Name@(category.IsArchived ? " (archived)" : "")</option>
                }
            </select>
        </div>
    </fieldset>
    @if (loading)
    {
        <p role="status">Loading expenses…</p>
    }
    else if (error is not null)
    {
        <div class="alert alert-danger" role="alert">@error</div>
        <button class="btn btn-outline-primary" disabled="@(!interactive)" @onclick="LoadAsync">Try again</button>
    }
    else if (result is not null && result.TotalCount == 0)
    {
        <div class="alert alert-info" role="status">
            No expenses match this month@(categoryId == 0 ? "." : " and category.") Choose another filter or add an expense.
        </div>
    }
    else if (result is not null)
    {
        <p role="status">Showing @((page - 1) * result.PageSize + 1)–@((page - 1) * result.PageSize + result.Items.Count) of @result.TotalCount expenses.</p>
        <div class="ledger-table" role="region" aria-label="Expense results; scroll horizontally on small screens" tabindex="0">
            <table class="table table-striped align-middle">
                <caption class="visually-hidden">Expenses for @month, ordered by date and ID descending</caption>
                <thead><tr><th scope="col">Date</th><th scope="col">Merchant</th><th scope="col">Category</th><th scope="col" class="amount">Amount (AUD)</th><th scope="col">Actions</th></tr></thead>
                <tbody>
                    @foreach (var expense in result.Items)
                    {
                        <tr @key="expense.Id">
                            <td class="date">@expense.ExpenseDate.ToString("dd MMM yyyy", Australian)</td>
                            <td class="merchant">@(expense.Merchant ?? "Not provided")</td>
                            <td>@expense.CategoryName</td>
                            <td class="amount">A$@((expense.AmountCents / 100m).ToString("N2", Australian))</td>
                            <td class="text-nowrap">
                                <a href="@Location.Url($"expenses/{expense.Id}/edit")" aria-label="@($"Edit expense {expense.Id}")">Edit</a>
                                <a class="text-danger ms-3" href="@Location.Url($"expenses/{expense.Id}/delete")" aria-label="@($"Delete expense {expense.Id}")">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <nav aria-label="Expense pages" class="ledger-paging">
            <button class="btn btn-outline-primary" disabled="@(loading || !interactive || page <= 1)" @onclick="PreviousAsync">Previous</button>
            <span>Page @(page) of @TotalPages</span>
            <button class="btn btn-outline-primary" disabled="@(loading || !interactive || page >= TotalPages)" @onclick="NextAsync">Next</button>
        </nav>
    }
</div>

@code {
    private static readonly CultureInfo Australian = CultureInfo.GetCultureInfo("en-AU");
    private static readonly TimeZoneInfo Sydney = TimeZoneInfo.FindSystemTimeZoneById("Australia/Sydney");
    private string CurrentMonth => TimeZoneInfo.ConvertTime(Clock.GetUtcNow(), Sydney).ToString("yyyy-MM", CultureInfo.InvariantCulture);
    private string month = "";
    private int categoryId;
    private int page = 1;
    private bool loading;
    private bool interactive;
    private string? error;
    private string? message;
    private int loadVersion;
    private LedgerLocation Location => new(month, categoryId, page);
    private ExpensePage? result;
    private IReadOnlyList<CategoryRow> categories = [];
    private int TotalPages => result is null ? 1 : Math.Max(1, (int)Math.Ceiling(result.TotalCount / (double)result.PageSize));

    protected override async Task OnParametersSetAsync()
    {
        // Query parameters change on back/forward navigation as well as filter clicks.
        var location = ReturnLocation;
        month = location.Month;
        categoryId = location.CategoryId;
        page = location.Page;
        message = Feedback.Take() ?? message;
        await LoadAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!loading && result is not null && Navigation.ToBaseRelativePath(Navigation.Uri) != Location.Url())
            Navigation.NavigateTo(Location.Url(), replace: true);
        // Prerendered controls wait for the interactive circuit before accepting changes.
        if (firstRender) { interactive = true; StateHasChanged(); }
    }

    private void MonthChangedAsync(ChangeEventArgs args)
    {
        if (loading) return;
        var selected = LedgerLocation.FromQuery(args.Value?.ToString(), categoryId.ToString(), "1", Clock);
        Navigation.NavigateTo(selected.Url());
    }

    private void CategoryChangedAsync(ChangeEventArgs args)
    {
        if (loading) return;
        var selected = LedgerLocation.FromQuery(month, args.Value?.ToString(), "1", Clock);
        Navigation.NavigateTo(selected.Url());
    }

    private void PreviousAsync()
    {
        if (!loading && page > 1) Navigation.NavigateTo((Location with { Page = page - 1 }).Url());
    }

    private void NextAsync()
    {
        if (!loading && page < TotalPages) Navigation.NavigateTo((Location with { Page = page + 1 }).Url());
    }

    private async Task LoadAsync()
    {
        // A back/forward navigation can overtake an in-flight query. Only the newest
        // request may publish results or clear the loading state.
        var version = ++loadVersion;
        var requested = Location;
        loading = true;
        error = null;
        result = null; // Never display old rows under newly selected filters or after an error.
        try
        {
            if (!DateOnly.TryParseExact(requested.Month + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
            {
                error = "Choose a month from January 2000 through the current month in Sydney.";
                return;
            }
            await Initializer.EnsureInitializedAsync();
            // Archived categories remain filterable because their historical expenses remain.
            var loadedCategories = await Categories.ListAsync(includeArchived: true);
            var response = await Expenses.ListAsync(new(date.Year, date.Month, requested.CategoryId == 0 ? null : requested.CategoryId, requested.Page));
            if (version != loadVersion) return;
            categories = loadedCategories;
            if (response.Status != ResultStatus.Success)
            {
                error = response.Error;
                return;
            }
            var loaded = response.Value!;
            var lastPage = Math.Max(1, (int)Math.Ceiling(loaded.TotalCount / (double)loaded.PageSize));
            if (requested.Page > lastPage)
            {
                requested = requested with { Page = lastPage };
                response = await Expenses.ListAsync(new(date.Year, date.Month, requested.CategoryId == 0 ? null : requested.CategoryId, requested.Page));
                if (version != loadVersion) return;
                if (response.Status != ResultStatus.Success) { error = response.Error; return; }
                loaded = response.Value!;
                page = lastPage;
            }
            result = loaded;
        }
        catch (Exception ex)
        {
            if (version != loadVersion) return;
            Logger.LogError(ex, "Expense ledger could not be loaded.");
            result = null;
            error = "We could not load your expenses. Your filters have been kept. Please try again.";
        }
        finally { if (version == loadVersion) loading = false; }
    }
}
